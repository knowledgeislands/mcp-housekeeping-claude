{
  "name": "@knowledgeislands/mcp-housekeeping-claude",
  "description": "MCP for auditing and pruning Claude Desktop, Claude Code, and VS Code session state on local filesystems.",
  "version": "0.9.0",
  "author": "kris@kris.me.uk",
  "bin": {
    "mcp-housekeeping-claude": "dist/mcp-server/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@modelcontextprotocol/client": "2.3.0",
    "@types/node": "^26.6.4",
    "@vitest/coverage-v8": "^5.0.3",
    "dependency-cruiser": "^18.5.0",
    "husky": "^9.1.7",
    "knip": "^6.39.0",
    "lint-staged": "^17.6.0",
    "mcporter": "^0.14.2",
    "rumdl": "^0.2.78",
    "syncpack": "^15.3.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/mcp-server/index.d.ts",
      "import": "./dist/mcp-server/index.js"
    },
    "./config": {
      "types": "./dist/config/index.d.ts",
      "import": "./dist/config/index.js"
    },
    "./claude-code": {
      "types": "./dist/main/claude-code/index.d.ts",
      "import": "./dist/main/claude-code/index.js"
    },
    "./claude-desktop": {
      "types": "./dist/main/claude-desktop/index.d.ts",
      "import": "./dist/main/claude-desktop/index.js"
    },
    "./vscode": {
      "types": "./dist/main/vscode/index.d.ts",
      "import": "./dist/main/vscode/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "homepage": "https://github.com/knowledgeislands/mcp-housekeeping-claude#readme",
  "keywords": [
    "anthropic",
    "audit",
    "bun",
    "claude",
    "filesystem",
    "housekeeping",
    "mcp",
    "model-context-protocol",
    "typescript"
  ],
  "license": "MIT",
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,jsonc}": [
      "bunx @biomejs/biome check --write --no-errors-on-unmatched"
    ],
    "*.md": [
      "bunx rumdl check --fix"
    ]
  },
  "main": "dist/mcp-server/index.js",
  "packageManager": "bun@1.4.2",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/knowledgeislands/mcp-housekeeping-claude.git"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf {dist,node_modules}",
    "ki:deps:update": "bun update --latest",
    "ki:generate:client": "mcporter emit-ts kit-mcp-housekeeping-claude --mode client --out src/generated/client.ts --types-out src/generated/types.d.ts && printf '// @ts-nocheck\\n' | cat - src/generated/client.ts > /tmp/gen-tmp.ts && mv /tmp/gen-tmp.ts src/generated/client.ts",
    "ki:server:mcp:dev": "NODE_ENV=development bun --watch src/mcp-server/index.ts",
    "ki:server:mcp:inspect": "NODE_ENV=development bunx @modelcontextprotocol/inspector bun src/mcp-server/index.ts",
    "ki:server:mcp:start": "bun run build && node dist/mcp-server/index.js",
    "ki:test:smoke": "bun run build && bun scripts/smoke.ts",
    "prepare": "husky && bun install --frozen-lockfile --cwd tooling/boundaries",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "type": "module"
}
